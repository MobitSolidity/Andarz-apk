   "display": {
    "size": 32,
    "weight": 700
   },
   "headline": {
    "size": 24,
    "weight": 700
   },
   "title": {
    "size": 18,
    "weight": 700
   },
   "bodyLarge": {
    "size": 16,
    "weight": 400
   },
   "body": {
    "size": 15,
    "weight": 400
   },
   "label": {
    "size": 12,
    "weight": 500
   }
  },
  "numerals": "Use tabular figures where the font supports them; money and R values are always wrapped in an LTR isolate."
 },
 "elevation": "Tonal: express depth with surface/surfaceAlt/surfaceHigh, not drop shadows (dark theme). Light theme may use 1-2dp shadows.",
 "motion": {
  "durationsMs": {
   "fast": 150,
   "standard": 250,
   "emphasized": 400
  },
  "easing": "Material standard; no bouncy or celebratory animation anywhere (a trading-discipline app never cheers for a win).",
  "reduceMotion": "Respect the system animation scale: at 0 skip all non-essential transitions."
 },
 "iconConcept": {
  "foreground": "upright tapered alef stroke in firouzeh, inside the adaptive-icon safe zone",
  "accent": "short saffron bar under the stroke",
  "background": "graphite #1C1E24 to #0D0E10 vertical gradient",
  "monochrome": "alef stroke only (themed icon)"
 }
