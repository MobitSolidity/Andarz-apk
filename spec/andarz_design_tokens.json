 "semantics": {
  "allowed_or_profit": "firouzeh",
  "caution_or_grade1_only": "saffron",
  "redline_or_loss": "anar",
  "info_or_chart": "lapis",
  "rule": "Colour is never the only signal: pair it with an icon and a +/- sign or a text label."
 },
 "shape": {
  "radiusSmall": 10,
  "radiusMedium": 16,
  "radiusLarge": 20,
  "radiusSheet": 28,
  "unit": "dp"
 },
